<UserControl
    x:Class="Kinlo.GUI.View.ProductionHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:Kinlo.Common.Converters;assembly=Kinlo.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:kc="clr-namespace:KinloControls;assembly=KinloControls"
    xmlns:local="clr-namespace:Kinlo.GUI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:tools="clr-namespace:Kinlo.Common.Tools;assembly=Kinlo.Common"
    xmlns:vm="clr-namespace:Kinlo.GUI.ViewModel"
    d:DataContext="{d:DesignInstance vm:ProductionHistoryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="1600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cvt:ProductionTypeToVIsibilityConverter x:Key="ProductionTypeToVIsibilityConverter" />
    </UserControl.Resources>
    <Border
        Grid.Row="2"
        Grid.ColumnSpan="9"
        Margin="0"
        Background="{DynamicResource RegionBrush}"
        CornerRadius="{DynamicResource MainCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <hc:ComboBox
                    MinWidth="120"
                    MaxHeight="80"
                    hc:TitleElement.Title="查询时间类型"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding SelectTimes}"
                    SelectedItem="{Binding FilterOption.TimeFilter.PropertyDisplayMap}" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <hc:DateTimePicker
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="160"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        hc:InfoElement.Title="{DynamicResource 开始时间}"
                        hc:TitleElement.TitlePlacement="Top"
                        SelectedDateTime="{Binding FilterOption.TimeFilter.StartTime}"
                        Style="{StaticResource DateTimePickerPlus}" />
                    <TextBlock
                        Margin="2,0,2,7"
                        VerticalAlignment="Bottom"
                        Text="~" />
                    <hc:DateTimePicker
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="160"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        hc:InfoElement.Title="{DynamicResource 结束时间}"
                        hc:TitleElement.TitlePlacement="Top"
                        SelectedDateTime="{Binding FilterOption.TimeFilter.EndTime}"
                        Style="{StaticResource DateTimePickerPlus}" />
                </WrapPanel>
                <hc:TextBox
                    Grid.Column="2"
                    MaxHeight="80"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    hc:InfoElement.Placeholder="单码：支持模糊查询。 多码：须完整匹配，兼容换行与逗号分隔"
                    hc:InfoElement.Title="{DynamicResource 输入条码（单码：支持模糊查询。 多码：须完整匹配，兼容换行与逗号分隔）}"
                    hc:TitleElement.TitlePlacement="Top"
                    AcceptsReturn="True"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding FilterOption.BarcodeFilter.Barcode, UpdateSourceTrigger=LostFocus}"
                    VerticalScrollBarVisibility="Auto" />

                <WrapPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Border
                        Height="28"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <CheckBox
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="条码模糊查询"
                            IsChecked="{Binding FilterOption.BarcodeFilter.IsFuzzyQuery}" />
                    </Border>

                    <Border
                        Height="28"
                        Margin="0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <CheckBox
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Content="去重"
                            IsChecked="{Binding FilterOption.IsNotRepeat}" />
                    </Border>
                    <Button
                        Grid.Row="1"
                        Grid.Column="6"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                        Command="{s:Action QueryCMD}"
                        Content="{DynamicResource 查询}"
                        IsDefault="True"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="7"
                        Margin="4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                        Command="{s:Action ExportExcelCMD}"
                        Content="{DynamicResource 导出}"
                        Style="{StaticResource ButtonSuccess}" />
                    <hc:ProgressButton
                        Grid.Row="1"
                        Grid.Column="7"
                        Height="29"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        hc:IconElement.Geometry="{StaticResource DownloadGeometry}"
                        kc:LanguageResource.Key="{Binding ExportButtonContent}"
                        Command="{s:Action ExportHipotCurveCMD}"
                        IsHitTestVisible="{Binding IsExporting, Converter={StaticResource Boolean2BooleanReConverter}}"
                        Progress="{Binding ExportProgress}"
                        Style="{StaticResource ProgressButtonInfo}"
                        Visibility="{Binding ParameterCfg.AdvancedConfig.ProductionType, Converter={StaticResource ProductionTypeToVIsibilityConverter}, ConverterParameter=一次注液}" />
                    <!--<Border
                        Margin="-1,0,0,0"
                        Padding="0,0,8,0"
                        Background="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0 4 4 0">
                        <CheckBox Content="详情" />
                    </Border>-->
                </WrapPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Margin="10,0,0,0"
                    Padding="15,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <UniformGrid
                        VerticalAlignment="Center"
                        Columns="2"
                        Rows="2">

                        <RadioButton
                            Margin="0,0,0,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            kc:LanguageResource.Key="全部"
                            FontSize="13.2"
                            FontWeight="Bold"
                            IsChecked="{Binding FilterOption.ResultFilter.ShowAll}" />
                        <RadioButton
                            Margin="0,0,0,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            kc:LanguageResource.Key="只看不合格"
                            FontSize="13.2"
                            FontWeight="Bold"
                            IsChecked="{Binding FilterOption.ResultFilter.ShowFailed}" />
                        <RadioButton
                            Margin="0,3,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            kc:LanguageResource.Key="自定义"
                            FontSize="13.2"
                            FontWeight="Bold"
                            IsChecked="{Binding FilterOption.ResultFilter.ShowCustom}" />
                        <RadioButton
                            Margin="0,3,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            kc:LanguageResource.Key="只看合格"
                            FontSize="13.2"
                            FontWeight="Bold"
                            IsChecked="{Binding FilterOption.ResultFilter.ShowPassed}" />
                    </UniformGrid>
                </Border>

                <Border
                    Grid.Column="2"
                    Margin="5,0,10,0"
                    Padding="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <ItemsControl
                        Grid.Column="1"
                        Margin="5,5,8,5"
                        ItemsSource="{Binding FilterOption.ResultFilter.FilterGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        VerticalAlignment="Stretch"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,0">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            kc:LanguageResource.Key="{Binding GroupName}"
                                            FontSize="13.2"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                    <ItemsControl
                                        Grid.Column="1"
                                        Margin="5,5,8,5"
                                        ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="8,3" IsChecked="{Binding IsSelected}">
                                                    <WrapPanel>
                                                        <TextBlock kc:LanguageResource.Key="{Binding Display}" />
                                                        <TextBlock kc:LanguageResource.Key="{Binding DisplaySuffix}" />
                                                    </WrapPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <Border
                    Height="30"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <WrapPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource other_QueryResult}" />
                        </WrapPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ToggleButton
                                x:Name="entityPropertyVisibleTBut"
                                Margin="0,0,10,0"
                                Command="{s:Action AdjustCmd}"
                                Content="&#xe615;"
                                FontFamily="/Font/#iconfont"
                                FontSize="18"
                                Foreground="#656565"
                                IsChecked="{Binding EntityPropertyVisibleVM.IsEntityPropertyVisible}"
                                Style="{StaticResource ToggleButtonCustom}"
                                ToolTip="{DynamicResource other_DisplayColumns}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ContentControl
                    Grid.Row="1"
                    Margin="10,0,10,0"
                    Content="{Binding ShowGridData}" />
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource 总计}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding TotalCount}" />
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource 条}" />
                    <hc:TextBox
                        Margin="20,0,0,0"
                        hc:TitleElement.Title="{DynamicResource 每页显示}"
                        hc:TitleElement.TitlePlacement="Left"
                        Text="{Binding DataCountPerPage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock
                        Margin="5,0,20,0"
                        VerticalAlignment="Center"
                        Text="{DynamicResource 条}" />
                    <hc:Pagination
                        HorizontalAlignment="Center"
                        DataCountPerPage="{Binding DataCountPerPage}"
                        IsJumpEnabled="True"
                        MaxPageCount="{Binding TotalPage}"
                        MaxPageInterval="4"
                        PageUpdated="{s:Action PaginationPageUpdatedCMD}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
